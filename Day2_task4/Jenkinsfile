
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stg', 'prod'],
            description: 'Choose the environment to deploy'
        )
    }

    stages {
        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Select Workspace') {
            steps {
                sh '''
                    set -eu

                    terraform workspace select "$ENVIRONMENT" \
                      || terraform workspace new "$ENVIRONMENT"

                    echo "Selected workspace:"
                    terraform workspace show
                '''
            }
        }

        stage('Terraform Validate') {
            steps {
                sh 'terraform validate'
            }
        }

        stage('Terraform Plan') {
            steps {
                sh '''
                    set -eu

                    terraform plan \
                      -var-file="${ENVIRONMENT}.tfvars" \
                      -out=tfplan

                    terraform show -no-color tfplan > plan.txt
                '''

                archiveArtifacts(
                    artifacts: 'plan.txt',
                    fingerprint: true
                )

                echo 'Terraform plan generated. Waiting for review next.'
            }
        }

        stage('Approval') {
            steps {
                script {
                    def approval = input(
                        id: 'TerraformApproval',
                        message: """
Review the Terraform plan for ${params.ENVIRONMENT}.

Open the archived plan.txt artifact before approving.
Approve only if the proposed changes are correct.
                        """.stripIndent(),
                        ok: 'Approve and Apply',
                        submitter: 'admin',
                        parameters: [
                            text(
                                name: 'APPROVAL_NOTE',
                                defaultValue: '',
                                description: 'Optional reason or approval note'
                            )
                        ]
                    )

                    echo "Approval received. Note: ${approval}"
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'terraform apply -auto-approve tfplan'
            }
        }
    }

    post {
        success {
            echo "Terraform deployment completed successfully for ${params.ENVIRONMENT}."
        }

        aborted {
            echo "Terraform deployment was aborted for ${params.ENVIRONMENT}."
        }

        failure {
            echo "Terraform deployment failed for ${params.ENVIRONMENT}."
        }

        always {
            sh 'rm -f tfplan'
        }
    }
}