
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stg', 'prod'],
            description: 'Choose the environment to deploy'
        )
    }

    stages {
        stage('Terraform Init') {
            steps {
                dir('Day2_task4') {
                    sh 'terraform init'
                }
            }
        }

        stage('Select Workspace') {
            steps {
                dir('Day2_task4') {
                    sh '''
                        set -eu

                        terraform workspace select "$ENVIRONMENT" \
                          || terraform workspace new "$ENVIRONMENT"

                        echo "Selected workspace:"
                        terraform workspace show
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('Day2_task4') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('Day2_task4') {
                    sh '''
                        set -eu

                        terraform plan \
                          -var-file="${ENVIRONMENT}.tfvars" \
                          -out=tfplan

                        terraform show -no-color tfplan > plan.txt
                    '''
                    archiveArtifacts(
                        artifacts: 'Day2_task4/plan.txt',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Approval') {
            steps {
                script {
                    input(
                        id: 'TerraformApproval',
                        message: "Review the ${params.ENVIRONMENT} Terraform plan in the archived plan.txt artifact. Approve deployment?",
                        ok: 'Approve and Apply',
                        submitter: 'admin'
                    )
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('Day2_task4') {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }
    }

    post {
        success {
            echo "Terraform deployment completed for ${params.ENVIRONMENT}."
        }

        aborted {
            echo "Deployment aborted for ${params.ENVIRONMENT}."
        }

        failure {
            echo "Deployment failed for ${params.ENVIRONMENT}."
        }

        always {
            dir('Day2_task4') {
                sh 'rm -f tfplan'
            }
        }
    }
}