    agent any

    stages {
        stage('Hello github') {
            steps {
                echo 'Hello github'
            }
        }
        stage('Hello NTI') {
            steps {
                echo 'Hello NTI'
            }
        }
        stage('Hello ITI') {
            steps {
                sh```
                chmod +x hello.sh
                ./hello.sh
                ```
            }
        }
    }
}
