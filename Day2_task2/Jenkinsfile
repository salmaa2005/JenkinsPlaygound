
pipeline {
    agent any

    stages {
        stage('Terraform Init') {
    steps {
        dir('Day2_task2') { 
            sh 'terraform init'
        }
    }
}

stage('Terraform Plan') {
    steps {
        dir('Day2_task2') {
            sh 'terraform plan -out=tfplan'
        }
    }
}

stage('Terraform Apply') {
    steps {
        dir('Day2_task2') {
            sh 'terraform apply -auto-approve tfplan'
        }
    }
}
    }

    post {
        success {
            echo 'VPC created successfully!'
        }
        failure {
            echo 'Terraform deployment failed!'
        }
    }
}

